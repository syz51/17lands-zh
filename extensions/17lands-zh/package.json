{
  "name": "17lands-zh",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "repository": "github:syz51/17lands-zh",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:store": "WXT_API_ORIGIN=https://17lands.syzroy.com wxt build && bun scripts/check-store.ts",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:store": "WXT_API_ORIGIN=https://17lands.syzroy.com wxt zip && bun scripts/check-store.ts",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "wxt": "0.21.4"
  }
}
